DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_BASE_URL=https://coin-portal.onrender.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-provider-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=CoinPortal 365 <notifications@example.com>
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
